{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanagentprotocol.com/schemas/conformance-job.schema.json",
  "title": "Source-owned HAP fixture verification job",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "definition", "interface", "workingDirectory", "command"],
  "properties": {
    "schema": {"const": "dev.hap.conformance-job/v1"},
    "definition": {"type": "string", "minLength": 1},
    "interface": {"type": "string", "minLength": 1},
    "workingDirectory": {"type": "string", "minLength": 1},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
