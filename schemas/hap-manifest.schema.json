{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanagentprotocol.com/schemas/hap-manifest.schema.json",
  "title": "HAP Manifest",
  "description": "Schema for hap.yaml — the Human Agent Protocol manifest file",
  "type": "object",
  "required": ["version", "agent"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Manifest spec version",
      "examples": ["0.1"]
    },
    "agent": {
      "type": "object",
      "description": "Agent metadata",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Agent name (lowercase, hyphens allowed)"
        },
        "version": {
          "type": "string",
          "description": "Agent version (semver-like)"
        },
        "description": {
          "type": "string",
          "description": "Short description of what the agent does"
        },
        "author": {
          "type": "string",
          "description": "Author or organization"
        },
        "license": {
          "type": "string",
          "description": "License identifier"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Searchable tags"
        }
      }
    },
    "mind": {
      "type": "object",
      "description": "LLM configuration",
      "properties": {
        "default": {
          "type": "string",
          "description": "Default model name"
        },
        "supported": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Supported model patterns"
        },
        "endpoint": {
          "type": ["string", "null"],
          "description": "Custom LLM endpoint URL"
        }
      }
    },
    "credentials": {
      "type": "object",
      "description": "Required and optional credentials",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "instructions": {
      "type": "object",
      "description": "Agent instruction configuration",
      "properties": {
        "path": {
          "type": "string",
          "description": "Path to instructions directory"
        },
        "format": {
          "type": "string",
          "enum": ["markdown", "text"],
          "description": "Instruction file format"
        },
        "hot_reload": {
          "type": "boolean",
          "description": "Whether instructions can be reloaded at runtime"
        },
        "supported": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Supported instruction categories"
        },
        "not_supported": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Unsupported instruction categories"
        }
      }
    },
    "activation": {
      "type": "object",
      "description": "How the agent is triggered",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["manual", "continuous", "scheduled", "event", "task"],
          "description": "Activation mode"
        },
        "schedule": {
          "type": "string",
          "description": "Cron expression (when mode=scheduled)"
        }
      },
      "if": {
        "properties": { "mode": { "const": "scheduled" } },
        "required": ["mode"]
      },
      "then": {
        "required": ["schedule"]
      }
    },
    "interfaces": {
      "type": "object",
      "description": "Communication interfaces",
      "properties": {
        "task": {
          "type": "object",
          "properties": {
            "format": { "type": "string" },
            "schema": { "type": "string" }
          }
        },
        "chat": {
          "type": "object",
          "properties": {
            "protocol": { "type": "string" }
          }
        },
        "human_feedback": {
          "type": "object",
          "properties": {
            "async": { "type": "boolean" }
          }
        }
      }
    },
    "a2a": {
      "type": "object",
      "description": "Agent-to-agent communication",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "input": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "accepts": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "reporting": {
      "type": "object",
      "description": "Reporting and observability",
      "properties": {
        "default": {
          "type": "string"
        },
        "adapters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "config_env": { "type": "string" }
            }
          }
        }
      }
    },
    "conduct": {
      "type": "object",
      "description": "Safety guardrails and failure handling",
      "properties": {
        "guardrails": {
          "type": "array",
          "items": { "type": "string" }
        },
        "failure_protocol": {
          "type": "string"
        }
      }
    },
    "debug": {
      "type": "object",
      "description": "Debug configuration",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interface": {
          "type": "string"
        },
        "auth": {
          "type": "boolean"
        }
      }
    },
    "cost_estimate": {
      "type": "object",
      "description": "Cost estimation metadata",
      "properties": {
        "llm_cost_per_task": {
          "type": "string"
        },
        "typical_monthly_llm": {
          "type": "string"
        },
        "required_subscriptions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "registry": {
      "type": "object",
      "description": "Container registry configuration for publishing",
      "properties": {
        "url": {
          "type": "string",
          "description": "Registry URL (e.g. ghcr.io, docker.io)"
        },
        "namespace": {
          "type": "string",
          "description": "Registry namespace or organization"
        }
      }
    }
  }
}
